{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stylegallery.local/consumer-reference/schema/runtime-evidence-manifest.schema.json",
  "title": "Closed component-state runtime evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "claim_boundary", "recorded_at", "environment", "run", "session", "records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_kind": { "const": "component_state_runtime_manifest" },
    "claim_boundary": { "const": "Scenario artifacts are evidence, not visual regression baselines or accessibility certification." },
    "recorded_at": { "type": "string", "format": "date-time" },
    "environment": { "$ref": "https://stylegallery.local/consumer-reference/schema/capture-session.schema.json#/$defs/environment" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "repository", "revision", "attempt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["local", "github_actions"] },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "session": { "$ref": "https://stylegallery.local/consumer-reference/schema/capture-session.schema.json#/$defs/completed_session" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://stylegallery.local/consumer-reference/schema/evidence-record.schema.json" }
    }
  }
}
