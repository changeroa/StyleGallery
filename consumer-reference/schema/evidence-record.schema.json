{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stylegallery.local/consumer-reference/schema/evidence-record.schema.json",
  "title": "Claim-scoped consumer component evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_id", "profile_id", "claim_boundary", "passes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "component_id": { "const": "button" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "claim_boundary": { "const": "Scenario artifacts are evidence, not visual regression baselines or accessibility certification." },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario_id", "artifact", "recorded_at", "environment", "run", "session", "scope", "channel", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "scenario_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "byte_length", "media_type"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "byte_length": { "type": "integer", "minimum": 1 },
              "media_type": { "enum": ["image/png", "application/json"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "media_type": { "const": "image/png" } }, "required": ["media_type"] },
                "then": { "required": ["width", "height"] }
              }
            ]
          },
          "recorded_at": { "type": "string", "format": "date-time" },
          "environment": { "$ref": "https://stylegallery.local/consumer-reference/schema/capture-session.schema.json#/$defs/environment" },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "repository", "revision", "attempt"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "enum": ["local", "github_actions"] },
              "repository": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "attempt": { "type": "integer", "minimum": 1 }
            }
          },
          "session": { "$ref": "https://stylegallery.local/consumer-reference/schema/capture-session.schema.json#/$defs/session_link" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "semantic_mode", "state_set"],
            "properties": {
              "component": { "const": "button" },
              "semantic_mode": { "enum": ["action", "toggle", "disclosure", "switch"] },
              "state_set": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          },
          "channel": { "enum": ["static", "browser", "visual", "dom", "ax", "human"] },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "observed"],
            "properties": {
              "status": { "const": "passed" },
              "observed": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
