{
  "color": {
    "$type": "color",
    "accent": { "$value": { "alpha": 1, "colorSpace": "srgb", "components": [0.58, 0.2, 0.12] } },
    "ink": { "$value": { "alpha": 1, "colorSpace": "srgb", "components": [0.12, 0.09, 0.07] } },
    "paper": { "$value": { "alpha": 1, "colorSpace": "srgb", "components": [0.97, 0.93, 0.84] } }
  },
  "duration": {
    "$type": "duration",
    "feedback": { "$value": { "unit": "ms", "value": 160 } }
  },
  "space": {
    "$type": "dimension",
    "page": { "$value": { "unit": "rem", "value": 1.5 } },
    "rhythm": { "$value": { "unit": "rem", "value": 0.75 } }
  }
}
